# ──────────────────────────────────────────────────────────────────
# OpenGTM — Environment Variables
# Copy to .env and fill in your keys
# ──────────────────────────────────────────────────────────────────

# === LLM Provider (at least one required for AI features) ===
# All providers are configured via the Settings UI at runtime.
# You can also pre-seed them here. Only one is needed.
#
# --- Anthropic (Claude) — premium, native Messages API ---
# Powers AI/research columns and chat with Claude. In a cloud deployment
# (YUPCHA_CLOUD=1) Claude becomes the default automatically when a key is set;
# self-hosted/OSS installs stay opt-in (set LLM_DEFAULT_PROVIDER=anthropic, or
# pick it in Settings). Either way the free providers below remain the fallback.
# ANTHROPIC_API_KEY=           # https://console.anthropic.com/settings/keys
# ANTHROPIC_MODEL=claude-opus-4-8   # default model (Claude Opus 4.8)
#
# Set on hosted/cloud deployments so Claude is the default provider when an
# Anthropic key is present. Leave unset for self-host to keep the free chain.
# YUPCHA_CLOUD=1
#
# --- Free / OSS-friendly providers (the default fallback chain) ---
# OPENROUTER_API_KEY=          # https://openrouter.ai/keys (free: 20 RPM)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# GOOGLE_AI_API_KEY=           # https://aistudio.google.com/app/apikey
# GOOGLE_AI_MODEL=gemini-2.0-flash
#
# GROQ_API_KEY=                # https://console.groq.com/keys (free: 30 RPM)
# GROQ_MODEL=llama-3.3-70b-versatile
#
# CEREBRAS_API_KEY=            # https://cloud.cerebras.ai/
# CEREBRAS_MODEL=llama-3.3-70b
#
# NVIDIA_API_KEY=              # https://build.nvidia.com/ (free: 40 RPM)
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
#
# MISTRAL_API_KEY=             # https://console.mistral.ai/api-keys
# MISTRAL_MODEL=mistral-small-latest
#
# GITHUB_MODELS_API_KEY=       # https://github.com/marketplace/models
# GITHUB_MODELS_MODEL=gpt-4o

# === Enrichment Providers (BYOK, all optional) ===
# These can also be configured in Settings → API Keys at runtime.
#
# HUNTER_API_KEY=              # https://hunter.io — Email finder (25/mo free)
# APOLLO_API_KEY=              # https://apollo.io — People + company enrichment (50/mo free)
# ABSTRACT_API_KEY=            # https://abstractapi.com — Email validation (100/mo free)
# NUMVERIFY_API_KEY=           # https://numverify.com — Phone validation (100/mo free)
# IPINFO_TOKEN=                # https://ipinfo.io — Company data from domain (50K/mo free)

# === CRM Integrations (optional) ===
# HUBSPOT_TOKEN=               # HubSpot Private App token — https://developers.hubspot.com/
# META_ACCESS_TOKEN=           # Meta Marketing API token for Custom Audiences
# GOOGLE_ADS_ACCESS_TOKEN=     # OAuth2 token for Customer Match
# GOOGLE_ADS_DEVELOPER_TOKEN=  # Approved Google Ads API developer token
# LINKEDIN_ACCESS_TOKEN=       # rw_dmp_segments access requires LinkedIn approval

# === Data Sources (optional) ===
# GOOGLE_PLACES_API_KEY=       # Google Places API for structured business data
# GOOGLE_API_KEY=              # Google Custom Search API key
# GOOGLE_CSE_ID=               # Google Custom Search Engine ID
# SERPINGAPI_API_KEY=          # Serping API key (Google SERP; keyed search fallback) — https://serpingapi.com
# SERPLY_API_KEY=              # Serply API key (Google SERP; keyed search fallback) — https://serply.io

# === Email Outreach (optional, also configurable in Settings) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=Yupcha
# SMTP_MAX_PER_HOUR=50

# === Security ===
# SECRET_KEY=                  # JWT signing key. REQUIRED, >= 32 bytes: the Go api/worker/mcp refuse to
#                              # start with an empty or shorter key unless APP_ENV=test (dev does NOT relax
#                              # this). Generate one with:  openssl rand -hex 48
# SECRETS_MASTER_KEY=          # Local Fernet custody (default provider).
# SECRETS_PROVIDER=local       # local | vault_transit
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=                 # Static token, or use the agent-managed file below.
# VAULT_TOKEN_FILE=            # Vault Agent token sink; reread on every operation.
# VAULT_TRANSIT_KEY=opengtm
# VAULT_NAMESPACE=             # Optional Vault Enterprise namespace.
# VAULT_CACERT=                # Optional private CA bundle path.
# Comma-separated FULL OIDC issuer URLs workspace admins may configure and log in with. An issuer
# must equal an entry exactly (scheme, host, port, path). Empty disables OIDC configuration.
# SSO_ALLOWED_ISSUERS=https://login.microsoftonline.com/<tenant>/v2.0,https://mycompany.okta.com
# DEPRECATED: host-only list. When set it only narrows SSO_ALLOWED_ISSUERS and never approves alone.
# SSO_ALLOWED_ISSUER_HOSTS=login.microsoftonline.com,mycompany.okta.com
# Public origin for the SSO redirect URI (https://<origin>/auth/sso/<slug>/callback).
# REQUIRED whenever SSO is enabled: there is no Host / X-Forwarded-Proto fallback. Without it,
# PUT /api/governance/sso with enabled:true answers 422 and SSO login answers 404 ("SSO is not
# available: the server has no SSO_REDIRECT_BASE_URL configured").
# SSO_REDIRECT_BASE_URL=
# Private-address IdP hosts (host or host:port, comma list) the SSO client may reach. Empty = public
# IdPs only. EGRESS_ALLOW_HOSTS does not apply to SSO.
# SSO_EGRESS_ALLOW_HOSTS=
# Legacy ?token= for SSE/WebSocket is accepted until this instant (RFC 3339 or YYYY-MM-DD); afterwards
# only POST /api/events/ticket works. Default 2027-01-31T00:00:00Z. Unparseable = closed immediately.
# SSE_QUERY_TOKEN_UNTIL=2027-01-31T00:00:00Z
# Workspace SCIM bearer-token lifetime. Values are clamped to 1-365 days.
# OPENGTM_SCIM_TOKEN_TTL_DAYS=90
# CRM inbound callback token lifetime, clamped to 1-365 days.
# OPENGTM_DESTINATION_TOKEN_TTL_DAYS=90
# Connector signatures are optional for local development. Set required on a
# managed catalog to load only packages signed by docs/connectors/trusted-publishers.json.
# CONNECTOR_SIGNATURE_POLICY=optional
# Exact immutable revision of this deployment. Required before any signed
# controlled-live certificate can expose an integration as supported.
# OPENGTM_BUILD_SHA=<full-git-commit-sha>
# APP_ENV=dev                  # Only `test` accepts an empty/short SECRET_KEY. APP_ENV never opens first-run /setup.
# ACCESS_TOKEN_EXPIRE_MINUTES=30          # short-lived access tokens (15–60 min)
# REFRESH_TOKEN_EXPIRE_MINUTES=20160      # refresh-token TTL (default 14 days)
# Maximum processing jobs per workspace across workers; 0 disables the cap.
# WORKER_MAX_ACTIVE_PER_WORKSPACE=2

# === Go services (api-go, worker-go, scheduler-go, mcp) ===
# Shared secret for service-to-service calls. REQUIRED (>= 32 chars, not change-me...): the worker and
# scheduler refuse to start without it. Generate with:  openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=
# Internal browser service (apps/browser-service). REQUIRED (>= 32 chars): the browser service refuses to start
# without it, and api-go / worker-go send it as the bearer token. Same value for all of them.
# Generate with:  openssl rand -hex 32
# BROWSER_SERVICE_TOKEN=
# BROWSER_SERVICE_URL=http://browser:8090
# Compose sets GO_ALL_NATIVE=true (every Go route/executor flag on; there is no Python fallback). A GO_* flag set
# here explicitly (including false) wins over the master switch.
# Plain postgresql:// URL (pgx) with the runtime role (non-superuser, NOBYPASSRLS). Compose builds it from
# YUPCHA_RUNTIME_DB_USER / YUPCHA_RUNTIME_DB_PASSWORD / POSTGRES_DB when unset.
# GO_DATABASE_URL=postgresql://yupcha_runtime:<YUPCHA_RUNTIME_DB_PASSWORD>@postgres:5432/yupcha
# nginx is the only client of api-go; trust its X-Real-IP. lead_net has a fixed subnet and
# TRUST_PROXY_CIDRS defaults to it (loopback-only trust is the code default). Change both together
# if the subnet collides with your network.
# LEAD_NET_SUBNET=172.29.250.0/24
# TRUST_PROXY_CIDRS=172.29.250.0/24
# Outreach: OUTREACH_PUBLIC_BASE_URL must be an https URL unless APP_ENV=dev, or the Go processes refuse to start.
# OUTREACH_PUBLIC_BASE_URL=https://outreach.example.com
# Scrape routes / unified search (keyed sources, sent only from Go): Google Custom Search and Books keys, and the
# LinkedIn session cookie (sent per request to the browser service, linkedin.com URLs only).
# GOOGLE_BOOKS_API_KEY=
# LINKEDIN_LI_AT_COOKIE=
# Allowed name prefixes for secret refs sent to user-chosen URLs (webhook header_secret_ref, watch
# webhook_secret_ref, warehouse/Slack destination refs). Comma list; set on api-go AND the worker.
# Provider/CRM/SMTP/IMAP/ads credentials can never be referenced. Slack refs need SLACK_ or DEST_.
# Rename existing webhook/destination secrets to one of these prefixes before upgrading.
# Whatever this list says, refs starting OIDC_, STRIPE_, SECRET_, JWT_, DATABASE_, REDIS_,
# INSTANTLY_, SMARTLEAD_ or AIRTABLE_ are always refused. A process without a settings registry
# refuses every ref (fail closed).
# OUTBOUND_SECRET_REF_PREFIXES=WEBHOOK_,AUTOMATION_,DEST_,SLACK_
# Ad-platform tokens resolve workspace-only when true (default false: workspace, global, env).
# AD_TOKENS_WORKSPACE_ONLY=false
# Webhook/Slack destination and automation webhook host allow-list (JSON array or comma list; exact host or .suffix).
# Include hooks.slack.com when Slack destinations are used.
# AUTOMATIONS_WEBHOOK_DOMAIN_ALLOWLIST=
# Copilot chat: CHAT_REQUIRE_AUTH defaults to true (self-host sets false explicitly).
# COPILOT_MAX_ANON_STREAMS caps anonymous chat streams (default 4, 1..1000).
# CHAT_REQUIRE_AUTH=true
# COPILOT_MAX_ANON_STREAMS=4
# Removed: TRUST_PROXY (ignored with a warning; use TRUST_PROXY_CIDRS) and FILES_API_MODE=legacy
# (api-go refuses to start with it).
# Host-local diagnostic ports (all bound to 127.0.0.1) and the public nginx port:
# PORT=3000  API_GO_PORT=8001  POSTGRES_PORT=5432  REDIS_PORT=6379
# GO_WORKER_CONCURRENCY=4
# GO_WORKER_DB_MAX_CONNS=20
# GO_WORKER_HEARTBEAT_SECONDS=10
# GO_WORKER_SHUTDOWN_GRACE_SECONDS=30
# GO_WORKER_DEBUG_ADDR=127.0.0.1:6060

# === Database (Postgres — required) ===
# Primary store for users, workbooks, jobs, and enrichment cells. Postgres gives
# real concurrent writers (MVCC), which the workbook enrichment run depends on.
# Compose uses the owner URL (DATABASE_URL) only for migrations and the separate non-superuser
# runtime login (GO_DATABASE_URL above) for API/worker/scheduler traffic so forced row-level security is effective.
# DATABASE_URL=postgresql://schema_owner:change-me@postgres:5432/yupcha
# YUPCHA_RUNTIME_DB_USER=yupcha_runtime
# YUPCHA_RUNTIME_DB_PASSWORD=   # REQUIRED, random (openssl rand -hex 24)
# Format: postgresql://USER[:PASSWORD]@HOST:PORT/DBNAME
#
# DOCKER COMPOSE: docker-compose.yml ships a `postgres` service and defaults
# DATABASE_URL to the line below automatically (built from POSTGRES_PASSWORD). Uncomment/override only
# to point at an external DB.
# DATABASE_URL=postgresql://yupcha:<POSTGRES_PASSWORD>@postgres:5432/yupcha

# === Postgres service (docker-compose) ===
# Credentials for the bundled `postgres` container. Must stay consistent with
# the user/password/db in DATABASE_URL above. There are NO default passwords: scripts/install.sh generates them, or set them here
# (compose refuses to start without POSTGRES_PASSWORD and YUPCHA_RUNTIME_DB_PASSWORD).
# POSTGRES_USER=yupcha
# POSTGRES_PASSWORD=             # REQUIRED, random (openssl rand -hex 24)
# POSTGRES_DB=yupcha
# POSTGRES_PORT=5432            # Host port mapping for the postgres container

# === First admin (Go API, served at /setup) ===
# A fresh install has NO users. Open the UI: it redirects to /setup, where you create the
# admin account.
# Takeover protection, in order of precedence:
#   SETUP_TOKEN set            -> that token must be entered on /setup (never logged).
#   SETUP_TOKEN_DISABLED=1     -> setup is open with no token (local dev only). This is the ONLY
#                                 switch; APP_ENV does not disable the token.
#   otherwise                  -> api-go generates a random token and logs it ONCE at start while
#                                 setup is required: `docker compose logs api-go | grep -i token`.
# The generated token is per-process; with several api-go replicas set SETUP_TOKEN explicitly.
# After setup (marker app_settings.setup_complete, also written on start when users already exist)
# the endpoint answers 409 to every caller with a valid token; without a valid token it is 401/403 first.
# SETUP_TOKEN=
# SETUP_TOKEN_DISABLED=

# === Demo seed (OPT-IN: docker compose --profile demo up) ===
# The `seed-go` service is NOT part of a default `docker compose up`. With the `demo` profile it
# seeds a self-filling demo workbook wired to ZERO-KEY providers into the workspace /setup created
# and starts its first run. It never creates a user: complete /setup first.
# SEED_WAIT_SECONDS=600        # how long it waits for /setup to finish (then exits 3; re-run it)
# SEED_WORKSPACE_SLUG=main
# SEED_FORCE_RUN=1             # Re-trigger the demo enrichment run on next boot

# === Server Config ===
# PORT=3000                    # Nginx port (docker-compose)
# LOG_LEVEL=info

# === Redis (live progress pub/sub) ===
# REDIS_URL=redis://localhost:6379

# === Proxy (optional, for web scraping at scale) ===
# PROXY_LIST=                  # Comma-separated proxy URLs
# PROXY_MANAGER_URL=http://localhost:3050  # Proxy manager service URL

# === Reacher email verification (OPTIONAL — default OFF) ===
# Reacher is the strongest tier of the email cascade: unlimited, $0/email SMTP
# RCPT probing (safe/risky/invalid/unknown + catch-all + disposable + role). It
# is DUAL-LICENSED AGPL-3.0 OR commercial; we run the AGPL build as a separate
# networked process (compliant — no GPL contamination). When REACHER_ENABLED is
# unset the cascade is byte-for-byte today's SMTP-only behavior.
#
# Two ways to use it:
#   1. Self-host the optional container:  docker compose --profile reacher up
#      → set REACHER_ENABLED=1 and REACHER_API_KEY (= the container's header
#        secret). REACHER_URL defaults to the internal http://reacher:8080.
#   2. Commercial cloud API (BYO key): set REACHER_ENABLED=1, REACHER_URL to the
#      cloud endpoint, and REACHER_API_KEY to your key.
#
# PORT-25 CAVEAT: most clouds block outbound :25, so a self-hosted Reacher needs
# a SOCKS5 proxy (RCH__PROXY__*) or it returns mostly `unknown` (cascade falls
# back to the bundled SMTP probe). SECURITY: REACHER_URL is GLOBAL/env-only and
# is NEVER overridable per-workspace (SSRF mitigation) — only REACHER_ENABLED and
# REACHER_API_KEY can be set per workspace.
# REACHER_ENABLED=0            # 1/true to wire Reacher into the cascade front
# REACHER_URL=http://reacher:8080   # global only; http(s), not a metadata host
# REACHER_API_KEY=             # Bearer secret (self-host header secret OR cloud key)
# REACHER_TIMEOUT=12           # seconds; Reacher can stall on greylisting
# REACHER_BREAKER_THRESHOLD=3  # consecutive failures before the breaker opens
# REACHER_BREAKER_COOLDOWN=60  # seconds the breaker stays open
# REACHER_FROM_EMAIL=verify@yupcha.com    # container MAIL FROM identity
# REACHER_HELLO_NAME=verify.yupcha.com    # container EHLO/HELO name
# REACHER_PROXY_HOST=          # optional SOCKS5 proxy to escape blocked :25
# REACHER_PROXY_PORT=
# REACHER_PROXY_USERNAME=
# REACHER_PROXY_PASSWORD=
