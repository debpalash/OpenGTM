  "description": "n8n community node for Yupcha — self-hosted GTM engine. Source leads, enrich companies, verify emails, detect tech stacks.",
  "keywords": [
    "n8n-community-node-package",
    "lead-generation",
    "b2b",
    "enrichment",
    "sales",
    "gtm",
    "yupcha"
  ],
  "license": "MIT",
  "author": {
    "name": "Yupcha",
    "url": "https://github.com/yupcha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yupcha/n8n-nodes-yupcha.git"
  },
  "main": "index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/YupchaApi.credentials.js"
