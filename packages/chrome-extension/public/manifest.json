{
    "manifest_version": 3,
    "name": "Yupcha Capture",
    "version": "0.1.0",
    "description": "Capture tables, lists, and LinkedIn people results from the page you're viewing into a Yupcha workbook.",
    "permissions": ["activeTab", "storage", "scripting"],
    "optional_host_permissions": ["https://*/*", "http://*/*"],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Yupcha Capture"
    },
    "options_page": "options.html"
}
