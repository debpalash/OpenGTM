{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "vite",
    "build": "tsc -b && vite build",
    "build:ui-preview": "tsc -b && vite build --config vite.ui-preview.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "portless:domain": "portless proxy start --tld sh",
    "portless:local": "portless proxy start --no-tls --port 1355 --tld sh",
    "portless:lan": "portless proxy start --lan --no-tls --port 1355",
    "portless:docker": "portless alias opengtm 3000 --force",
    "portless:list": "portless list",
    "portless:doctor": "portless doctor"
  },
  "portless": {
    "name": "opengtm",
    "script": "dev:app"
  },
