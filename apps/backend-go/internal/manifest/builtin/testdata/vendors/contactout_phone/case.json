    {
      "name": "no_phone",
      "status": 200,
      "file": "no_phone.json",
      "error": "no_data"
    },
    {
      "name": "vendor_error",
      "status": 404,
      "file": "error.json",
      "error": "http_404"
    }
  ],
  "credential": "test-key-123",
  "lead": {
    "website": "https://www.acme.com/about",
    "contact_person": "Ada Lovelace",
