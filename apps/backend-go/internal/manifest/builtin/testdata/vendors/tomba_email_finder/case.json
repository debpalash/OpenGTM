{
  "docs": [
    "https://docs.tomba.io/openapi.md",
    "(response bodies are built from the documented data fields of GET /email-finder; headers from https://docs.tomba.io/authentication.md)",
    "https://docs.tomba.io/error-handling.md"
  ],
  "request": {
    "method": "GET",
    "host": "api.tomba.io",
    "path": "/v1/email-finder",
    "query": {
      "domain": "acme.com",
      "first_name": "Ada",
      "last_name": "Lovelace"
    },
    "headers": {
      "X-Tomba-Key": "test-key-123",
      "X-Tomba-Secret": "test-secret-456"
    },
    "body": null
  },
  "responses": [
    {
      "name": "hit",
      "status": 200,
      "file": "hit.json",
      "fields": {
        "email": "ada@acme.com"
      }
    },
    {
      "name": "no_address_is_a_miss",
      "status": 200,
      "file": "none.json",
      "error": "no_data"
    },
    {
      "name": "errors_object_in_200",
      "status": 200,
      "file": "errors200.json",
      "error": "Either domain or company parameter must be provided."
    },
    {
      "name": "disposable_domain_is_400",
      "status": 400,
      "file": "error400.json",
      "error": "http_400"
    }
  ],
  "credential": "test-key-123",
  "secondary_credential": "test-secret-456",
  "lead": {
    "website": "https://www.acme.com/about",
    "contact_person": "Ada Lovelace",
    "email": "ada@acme.com",
    "linkedin_url": "https://www.linkedin.com/in/ada-lovelace"
  }
}
