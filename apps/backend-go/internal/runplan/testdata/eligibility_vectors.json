   },
   "request": {
    "method": "GET",
    "url": "https://api.example.com/x",
    "headers": {}
   },
   "response": {
    "mappings": {
     "email": "$.e"
    }
   }
  },
  "m_noauth": {
   "name": "m_noauth",
   "capability": "company_size",
   "auth": {
    "type": "none"
   },
   "request": {
    "method": "GET",
    "url": "https://api.example.com/x",
    "headers": {}
   },
   "response": {
    "mappings": {
     "company_size": "$.s"
    }
   }
  }
