  }
 ],
 "big_columns": [
  {
   "id": "company",
   "name": "Company",
   "type": "lead_field",
   "width": 200,
   "lead_field": "company"
  },
  {
   "id": "plat_big",
   "name": "Platform Chain",
   "type": "waterfall",
   "width": 220,
   "waterfall": [
    "research"
   ],
   "target_field": "description"
  }
 ]
}
