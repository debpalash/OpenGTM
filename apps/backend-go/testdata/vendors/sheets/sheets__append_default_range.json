{
 "vendor": "sheets",
 "scenario": "append_default_range",
 "call": {
  "function": "append_row",
  "args": {
   "spreadsheet_id": "sheet-contract-01",
   "values": [
    "a",
    "b"
   ]
  }
 },
 "secrets": {
  "GOOGLE_SHEETS_TOKEN": "ctk_sheets_alpha_0001"
 },
 "http_exchanges": [
  {
   "request": {
    "method": "POST",
    "url": "https://sheets.googleapis.com/v4/spreadsheets/sheet-contract-01/values/Sheet1:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS",
    "headers": {
     "authorization": "Bearer {{secret:GOOGLE_SHEETS_TOKEN}}",
     "content-type": "application/json"
    },
    "body": "{\"values\":[[\"a\",\"b\"]]}",
    "json": {
     "values": [
      [
       "a",
       "b"
      ]
     ]
    }
   },
   "response": {
    "status": 200,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"updates\":{\"updatedRange\":\"Sheet1!A3:B3\"}}"
   }
  }
 ],
 "sleeps": [],
 "result": {
  "success": true,
  "range": "Sheet1!A3:B3"
 }
}
