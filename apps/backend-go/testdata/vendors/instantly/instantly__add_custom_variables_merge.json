{
 "vendor": "instantly",
 "scenario": "add_custom_variables_merge",
 "call": {
  "function": "add_lead_to_campaign",
  "args": {
   "campaign_id": "camp-1",
   "lead": {
    "email": "a@b.co",
    "custom_variables": {
     "x": 1
    },
    "website": "https://b.co",
    "job_title": "CEO",
    "region": "EU"
   },
   "skip_if_in_campaign": false
  }
 },
 "secrets": {
  "INSTANTLY_API_KEY": "ctk_instantly_alpha_0001"
 },
 "http_exchanges": [
  {
   "request": {
    "method": "POST",
    "url": "https://api.instantly.ai/api/v2/leads",
    "headers": {
     "authorization": "Bearer {{secret:INSTANTLY_API_KEY}}",
     "content-type": "application/json"
    },
    "body": "{\"campaign\":\"camp-1\",\"skip_if_in_campaign\":false,\"email\":\"a@b.co\",\"website\":\"https://b.co\",\"job_title\":\"CEO\",\"custom_variables\":{\"x\":1,\"region\":\"EU\"}}",
    "json": {
     "campaign": "camp-1",
     "skip_if_in_campaign": false,
     "email": "a@b.co",
     "website": "https://b.co",
     "job_title": "CEO",
     "custom_variables": {
      "x": 1,
      "region": "EU"
     }
    }
   },
   "response": {
    "status": 201,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"id\":\"lead-2\"}"
   }
  }
 ],
 "sleeps": [],
 "result": {
  "success": true,
  "lead_id": "lead-2",
  "duplicate": false
 }
}
