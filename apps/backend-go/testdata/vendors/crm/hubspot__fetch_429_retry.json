{
 "vendor": "hubspot",
 "scenario": "fetch_429_retry",
 "call": {
  "function": "fetch_contacts",
  "args": {
   "limit": 2
  }
 },
 "secrets": {
  "HUBSPOT_TOKEN": "ctk_hubspot_alpha_0001"
 },
 "http_exchanges": [
  {
   "request": {
    "method": "GET",
    "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit=2&properties=email%2Cfirstname%2Clastname%2Ccompany%2Cphone%2Cwebsite%2Cjobtitle",
    "headers": {
     "authorization": "Bearer {{secret:HUBSPOT_TOKEN}}",
     "content-type": "application/json"
    },
    "body": ""
   },
   "response": {
    "status": 429,
    "headers": {
     "content-type": "application/json",
     "retry-after": "2"
    },
    "body": "{\"status\":\"error\",\"message\":\"You have reached your secondly limit.\",\"category\":\"RATE_LIMITS\"}"
   }
  },
  {
   "request": {
    "method": "GET",
    "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit=2&properties=email%2Cfirstname%2Clastname%2Ccompany%2Cphone%2Cwebsite%2Cjobtitle",
    "headers": {
     "authorization": "Bearer {{secret:HUBSPOT_TOKEN}}",
     "content-type": "application/json"
    },
    "body": ""
   },
   "response": {
    "status": 200,
    "headers": {
     "content-type": "application/json"
    },
    "body": "{\"results\":[{\"id\":\"1\",\"properties\":{\"email\":\"c1@example.com\",\"firstname\":\"C\",\"lastname\":\"1\",\"company\":\"Co 1\",\"phone\":\"\",\"website\":null,\"jobtitle\":\"Dev\"}},{\"id\":\"2\",\"properties\":{\"email\":\"c2@example.com\",\"firstname\":\"C\",\"lastname\":\"2\",\"company\":\"Co 2\",\"phone\":\"\",\"website\":null,\"jobtitle\":\"Dev\"}}]}"
   }
  }
 ],
 "sleeps": [
  2.0
 ],
 "result": {
  "success": true,
  "contacts": [
   {
    "email": "c1@example.com",
    "company": "Co 1",
    "contact_title": "Dev",
    "contact_person": "C 1",
    "crm_external_id": "1",
    "crm_type": "hubspot",
    "crm_object": "contact"
   },
   {
    "email": "c2@example.com",
    "company": "Co 2",
    "contact_title": "Dev",
    "contact_person": "C 2",
    "crm_external_id": "2",
    "crm_type": "hubspot",
    "crm_object": "contact"
   }
  ]
 }
}
