     "id": "trg-a-01",
     "workspace_id": "ws-alpha",
     "name": "New row webhook",
     "enabled": true,
     "trigger_type": "on_row_added",
     "trigger_config": {},
     "condition": "{company} != \"\"",
     "actions": [
      {
       "type": "webhook",
       "config": {
        "url": "https://hooks.example.com/auto/{company}",
        "method": "POST",
        "headers": {
         "X-Source": "opengtm"
        },
        "body": {
         "company": "{company}",
         "site": "{website}"
