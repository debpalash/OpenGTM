      "slug": "webhook-export-pipeline",
      "workbook": {
        "columns": [
          {
            "id": "company",
            "lead_field": "company",
            "name": "Company",
            "type": "lead_field",
            "width": 200
          },
          {
            "id": "website",
            "lead_field": "website",
            "name": "Website",
            "type": "lead_field",
            "width": 200
          },
          {
            "condition": "{email} == \"\"",
            "id": "email",
            "name": "Email (verified)",
            "target_field": "email",
            "type": "waterfall",
            "verify": true,
            "waterfall": [
