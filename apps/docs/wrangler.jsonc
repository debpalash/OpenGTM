// Cloudflare Workers (static assets) config for the OpenGTM docs site.
//
//   bun run build          # astro build → dist/
//   bunx wrangler deploy   # uploads dist/ as Worker static assets
//
// The custom domain below is attached on first deploy; the zone for
// palash.dev must already live in the same Cloudflare account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengtm-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "opengtm.palash.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
